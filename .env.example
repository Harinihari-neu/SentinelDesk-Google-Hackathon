GEMINI_API_KEY=
LLM_BACKEND=gemini
LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=gemini-3.5-flash
# LLM_THINKING_BUDGET=0
# LLM_THINKING_LEVEL=minimal         # Gemini 3.x: minimal|low|medium|high (wins over THINKING_BUDGET)
# Error handling (defaults shown). 429/5xx/timeouts retry with backoff; 404/400/truncated go to fallbacks.
# LLM_MODEL_FALLBACKS=gemini-3.1-flash-lite   # comma-separated, tried in order when LLM_MODEL fails
# LLM_MAX_RETRIES=2
# LLM_BACKOFF_S=1
# LLM_MAX_BACKOFF_S=8
# LLM_DEADLINE_S=20                   # give up and escalate after this many seconds
# LLM_TIMEOUT_S=30                    # per request
# LLM_MIN_INTERVAL_S=0                # set ~4 for batch evals on the free tier (per-minute quota)
RAG_K=3

# Option B (Vertex AI on the GCP project, leave GEMINI_API_KEY empty):
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=hackathon2026-487419
# GOOGLE_CLOUD_LOCATION=us-central1
